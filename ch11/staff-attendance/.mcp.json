{
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"]
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"]
    },
    "playwright-edge": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest", "--browser", "msedge"]
    },
    "playwright-firefox": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest", "--browser", "firefox"]
    },
    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest"]
    },
    "supabase": {
      "type": "http",
      "url": "https://mcp.supabase.com/mcp?features=docs,account,database,debugging,development,functions,branching"
    },
    "postgresql": {
      "command": "npx",
      "args": ["-y", "@henkey/postgres-mcp-server"]
    },
    "kubernetes": {
      "command": "npx",
      "args": ["-y", "mcp-server-kubernetes"]
    },
    "markitdown": {
      "command": "uvx",
      "args": ["markitdown-mcp"]
    },
    "vercel": {
      "type": "http",
      "url": "https://mcp.vercel.com"
    },
    "shadcn": {
      "command": "npx",
      "args": ["shadcn@latest", "mcp"]
    },
    "tosspayments-integration-guide": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@tosspayments/integration-guide-mcp@latest"],
      "env": {}
    },
    "portone-mcp-server": {
      "command": "npx",
      "args": ["-y", "@portone/mcp-server@latest"]
    },
    "sast": {
      "command": "uvx",
      "args": ["sast-mcp-server"]
    },
    "figma": {
      "type": "http",
      "url": "https://mcp.figma.com/mcp"
    },
    "webpixels": {
      "command": "npx",
      "args": ["-y", "@webpixels/mcp"]
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PAT}"
      }
    }
  },
  "GITHUB MCP 설정 방법": [
    "GITHUB_PAT는 환경변수에 등록해야 함",
    "윈도우의 '설정-시스템-고급시스템설정-환경변수' 로 이동하여",
    "사용자 변수에 새로 만들기 버튼을 클릭한 후 GITHUB_PAT 환경변수를 추가한다.",
    "github의 PAT 발급은 https://github.com/settings/apps 로 이동하여",
    "personal access token을 새로 발급받는다.",
    "Classic Token, Fine grained token 어느쪽이든 관계없음"
  ]
}
