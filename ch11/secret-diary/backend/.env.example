# 서버 설정
NODE_ENV=development
PORT=3000

# 데이터베이스 (Supabase PostgreSQL 연결 문자열)
DB_CONN_STRING=postgresql://<user>:<password>@<host>:<port>/<database>

# JWT 서명 비밀키 (Access/Refresh는 반드시 서로 다른 값을 사용한다)
JWT_ACCESS_SECRET=<random-secret-string>
JWT_REFRESH_SECRET=<random-secret-string>

# 토큰 유효 기간(초). 미설정 시 기본값(Access 12h / Refresh 7d) 사용
ACCESS_TOKEN_TTL_SECONDS=43200
REFRESH_TOKEN_TTL_SECONDS=604800

# CORS 허용 origin (쉼표로 다중 origin 구분)
CORS_ORIGIN=http://localhost:5173
