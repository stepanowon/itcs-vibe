PORT=3000
# development: FE/BE가 localhost 포트만 다름(same-site) → sameSite:'lax'로 충분
# production: FE/BE가 실제로 다른 도메인(cross-site)이면 NODE_ENV=production 설정 시
#             sameSite:'none'+secure:true로 자동 전환됨 (server.js 참고, HTTPS 필수)
NODE_ENV=development
FRONTEND_URL=http://localhost:8080

# 네이버 개발자센터(https://developers.naver.com/apps) > 애플리케이션 등록에서 발급
NAVER_CLIENT_ID=your-naver-client-id
NAVER_CLIENT_SECRET=your-naver-client-secret
# 애플리케이션 설정의 "Callback URL"에 아래 값과 동일하게 등록해야 함
NAVER_REDIRECT_URI=http://localhost:3000/auth/naver/callback
